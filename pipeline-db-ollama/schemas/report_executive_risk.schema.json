{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeline.local/schemas/report_executive_risk.schema.json",
  "type": "object",
  "required": [
    "schema_version", "submission_id", "report_type", "generated_at",
    "model", "prompt_version", "sanitization_manifest_id",
    "risk_level", "summary_claim_id", "key_finding_ids",
    "mitre_techniques", "claims", "abstentions", "insufficient_evidence"
  ],
  "properties": {
    "schema_version": { "const": "report-output/1.0" },
    "submission_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "report_type": { "const": "executive_risk" },
    "generated_at": { "$ref": "common.schema.json#/$defs/IsoUtc" },
    "model": { "type": "string" },
    "prompt_version": { "type": "string" },
    "sanitization_manifest_id": { "type": "string" },
    "risk_level": { "enum": ["none", "low", "medium", "high", "critical", "unknown"] },
    "summary_claim_id": { "type": "string", "minLength": 1 },
    "key_finding_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "mitre_techniques": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technique_id", "name", "evidence_claim_ids"],
        "properties": {
          "technique_id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "name": { "type": "string", "minLength": 1 },
          "evidence_claim_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": { "$ref": "common.schema.json#/$defs/ClaimLong" }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "reason", "evidence_gap"],
        "properties": {
          "section": { "type": "string" },
          "reason": { "type": "string" },
          "evidence_gap": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "insufficient_evidence": { "type": "boolean" },
    "summary_claim_text": { "type": "string" },
    "summary_evidence_claim_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "generation_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunks_total":  { "type": "integer", "minimum": 0 },
        "chunks_failed": { "type": "integer", "minimum": 0 },
        "degraded":      { "type": "boolean" }
      },
      "required": ["chunks_total", "chunks_failed", "degraded"]
    }
  },
  "additionalProperties": false
}
