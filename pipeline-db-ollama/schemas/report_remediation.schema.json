{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pipeline.local/schemas/report_remediation.schema.json",
  "type": "object",
  "required": [
    "schema_version", "submission_id", "report_type", "generated_at",
    "model", "prompt_version", "sanitization_manifest_id",
    "threat_model_claim_id", "recommendations", "claims", "abstentions"
  ],
  "properties": {
    "schema_version": { "const": "report-output/1.0" },
    "submission_id": { "$ref": "common.schema.json#/$defs/Uuid" },
    "report_type": { "const": "remediation" },
    "generated_at": { "$ref": "common.schema.json#/$defs/IsoUtc" },
    "model": { "type": "string" },
    "prompt_version": { "type": "string" },
    "sanitization_manifest_id": { "type": "string" },
    "threat_model_claim_id": { "type": "string", "minLength": 1 },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recommendation_id", "category", "priority", "action",
          "rationale_claim_id", "playbook_id", "verification", "applies_to",
          "addresses_phases"
        ],
        "properties": {
          "recommendation_id": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "email_delivery", "phishing", "credential_theft",
              "persistence", "lateral_movement", "ransomware", "general"
            ]
          },
          "priority": { "enum": ["immediate", "high", "medium", "low"] },
          "action": { "type": "string", "minLength": 10 },
          "rationale_claim_id": { "type": "string", "minLength": 1 },
          "playbook_id": { "type": "string", "minLength": 1 },
          "verification": { "type": "string", "minLength": 10 },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "addresses_phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "delivery", "execution", "persistence", "privilege_escalation",
                "defense_evasion", "credential_access", "discovery",
                "lateral_movement", "collection", "command_and_control",
                "exfiltration", "impact", "unknown"
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "common.schema.json#/$defs/Claim" }
    },
    "abstentions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "reason", "evidence_gap"],
        "properties": {
          "section": { "type": "string" },
          "reason": { "type": "string" },
          "evidence_gap": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "generation_meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chunks_total":  { "type": "integer", "minimum": 0 },
        "chunks_failed": { "type": "integer", "minimum": 0 },
        "degraded":      { "type": "boolean" }
      },
      "required": ["chunks_total", "chunks_failed", "degraded"]
    }
  },
  "additionalProperties": false
}
